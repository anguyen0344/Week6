<Window x:Class="ActionRecord6B.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Civic Archive Dome" Height="350" Width="520">
    <StackPanel Margin="30">
        <TextBlock Text="Civic Archive Dome"
                   FontSize="26" FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <TextBlock Text="What is your character's name?"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="CharacterNameBox"
                 FontSize="18" Margin="0,0,0,15"/>

        <Button Content="Enter the Dome"
                Height="40" Click="EnterDome_Click"/>

        <TextBlock x:Name="ResponseText"
                   FontSize="18" TextWrapping="Wrap"
                   Margin="0,20,0,0"/>
    </StackPanel>
</Window>